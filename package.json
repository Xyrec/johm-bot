{
  "name": "wow-discord-bot",
  "version": "1.0.0",
  "description": "Button-based role picker bot for the Exodus WoW guild Discord",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node --env-file=.env dist/index.js",
    "inspect": "node --env-file=.env scripts/inspect.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
